# Server Configuration
NODE_ENV=development
PORT=5001
API_VERSION=v1

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/car-salahakar
MONGODB_DB_NAME=car-salahakar

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs

# Application Configuration
APP_NAME=Car Salahakar API
APP_URL=http://localhost:5001
FRONTEND_URL=http://localhost:8080

# SEO Default Values
DEFAULT_SITE_TITLE=Car Salahakar - Your Trusted Car Advisor
DEFAULT_SITE_DESCRIPTION=Find the best cars, compare prices, read reviews, and make informed decisions with Car Salahakar.
DEFAULT_SITE_KEYWORDS=cars, car reviews, car comparison, car prices, automotive

# Super Admin Configuration
SUPER_ADMIN_EMAIL=admin@carsalhakar.com
SUPER_ADMIN_PASSWORD=admin@123
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=+1234567890
